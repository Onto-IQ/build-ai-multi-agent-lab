{
  "name": "build-ai-multi-agent-lab",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:labs": "vitest run --config vitest.labs.config.ts",
    "test:e2e": "playwright test",
    "start": "node ./dist/server/entry.mjs",
    "create-issues": "node scripts/create-course-issues.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "astro": "^7.3.4",
    "better-sqlite3": "^13.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "better-sqlite3@13.0.3": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "vitest": "^5.0.1"
  }
}
